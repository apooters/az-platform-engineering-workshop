<mxfile host="app.diagrams.net">
  <diagram id="hotelbooking-environments" name="hotelbooking-environments">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="tmpl" value="&lt;b&gt;One template&lt;/b&gt;: infra/workload/main.bicep&lt;br&gt;+ one parameter file per environment&lt;br&gt;(no environment branches in the template)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ptest" value="&lt;b&gt;main.test.bicepparam&lt;/b&gt;&lt;br&gt;env=test, 10.20.0.0/16&lt;br&gt;zoneRedundant=false, min replicas 0, max 3&lt;br&gt;SQL GP_S_Gen5_1, auto-pause 60 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pprod" value="&lt;b&gt;main.prod.bicepparam&lt;/b&gt;&lt;br&gt;env=prod, 10.21.0.0/16&lt;br&gt;zoneRedundant=true, min replicas 3, max 6&lt;br&gt;SQL GP_S_Gen5_2, no auto-pause, zone backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1220" y="120" width="420" height="90" as="geometry" />
        </mxCell>

